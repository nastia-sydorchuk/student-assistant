# Copy to .env and fill in. Used by docker compose.

# Required: Gemini key for the chat assistant (free, no billing: https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Optional: Google Cloud Translate key. Without it, non-English content falls back to English
# (the UI text is still translated).
GOOGLE_TRANSLATE_KEY=

# Optional: shared secret between the backend and the RAG service. Any long random string.
RAG_API_KEY=
